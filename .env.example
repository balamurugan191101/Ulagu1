
NODE_ENV=development
PORT=5000

# PostgreSQL / Neon
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Allowed web origins, comma separated. Set real HTTPS origins in production.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Set only when behind a trusted reverse proxy (for example: 1)
TRUST_PROXY=

# Generate at least 32 random bytes; never commit the actual value.
JWT_SECRET=
JWT_EXPIRES_IN=15m
